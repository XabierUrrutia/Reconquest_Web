# Copia este archivo a .env y rellena los valores
# El .env nunca se sube a git (ya está en .gitignore)

# PostgreSQL — en producción usa la connection string de Neon (incluye sslmode=require)
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require

# Clave secreta Flask — OBLIGATORIA en producción (Render env var)
# Sin esta var las sesiones se invalidan en cada reinicio del dyno
SECRET_KEY=cambia_esto_por_un_string_largo_aleatorio

# Password del usuario admin creado en init_db (solo si no existe ningún admin)
# Si no se configura se genera una aleatoria y se imprime UNA SOLA VEZ en los logs
ADMIN_PASSWORD=

# OpenRouter (chatbot) — deja vacío para deshabilitar el chatbot en local
OPENROUTER_API_KEY=

# Email (deja vacío para usar el modo dev con link en pantalla)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URL base (para links en emails)
SITE_URL=http://localhost:5000
